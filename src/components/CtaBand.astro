---
import { site } from "../config/site";
import Icon from "./Icon.astro";

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = "Need something sworn today?",
  body = "Call or text and Peggy will tell you within a minute whether a Commissioner for Oaths is the right person for your document — and when she can be at your door.",
} = Astro.props;
---

<section class="container-page mt-20">
  <div
    class="relative overflow-hidden rounded-3xl bg-ink-900 px-6 py-14 text-center md:px-16 md:py-20"
  >
    <div
      class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full bg-brass-500/15 blur-2xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 -left-10 size-72 rounded-full bg-brass-400/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-2xl">
      <h2 class="text-3xl text-white md:text-4xl">{heading}</h2>
      <p class="mt-4 text-base leading-relaxed text-ink-200 md:text-lg">{body}</p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href={`tel:${site.phoneHref}`}
          class="inline-flex items-center justify-center gap-2.5 rounded-full bg-brass-500 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-brass-400"
        >
          <Icon name="phone" class="size-5" />
          {site.phone}
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2.5 rounded-full border border-white/25 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-white/10"
        >
          Request an appointment
        </a>
      </div>
    </div>
  </div>
</section>
