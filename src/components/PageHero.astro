---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-ink-100 bg-parchment">
  <div class="container-page py-14 md:py-20">
    {
      Astro.slots.has("breadcrumbs") && (
        <div class="mb-8">
          <slot name="breadcrumbs" />
        </div>
      )
    }
    {
      eyebrow && (
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-3 max-w-3xl text-4xl leading-[1.1] md:text-5xl">{title}</h1>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">{lead}</p>
      )
    }
    <slot />
  </div>
</section>
