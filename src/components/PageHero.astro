---
import { Image } from "astro:assets";

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Optional background photo. Pass an import from `src/config/heroImages.ts`. */
  image?: ImageMetadata;
}

const { eyebrow, title, lead, image } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-ink-100 bg-parchment">
  {
    image && (
      <>
        <Image
          src={image}
          alt=""
          width={2000}
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          quality={72}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 size-full object-cover"
        />
        {/* Scrim: the hero text is dark ink on parchment, so the photo needs
            knocking back to keep the h1 and lead legible over it. */}
        <div
          class="absolute inset-0 -z-10 bg-parchment/40 bg-gradient-to-r from-parchment via-parchment/88 to-parchment/35"
          aria-hidden="true"
        />
      </>
    )
  }

  <div class="container-page relative py-14 md:py-20">
    {
      Astro.slots.has("breadcrumbs") && (
        <div class="mb-8">
          <slot name="breadcrumbs" />
        </div>
      )
    }
    {
      eyebrow && (
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-3 max-w-3xl text-4xl leading-[1.1] md:text-5xl">{title}</h1>
    {
      lead && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600">{lead}</p>
      )
    }
    <slot />
  </div>
</section>
