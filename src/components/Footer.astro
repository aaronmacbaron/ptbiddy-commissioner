---
import { site, nav } from "../config/site";
import { services } from "../config/services";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-100 bg-ink-900 text-ink-200">
  <div class="container-page grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-2xl text-white">{site.name}</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-300">
        {site.tagline}
      </p>
      <p class="mt-6 text-sm text-ink-300">
        Appointed under Alberta's <em>Notaries and Commissioners Act</em>.
      </p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-brass-300">
        Get in touch
      </h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a
            href={`tel:${site.phoneHref}`}
            class="inline-flex items-center gap-2.5 text-ink-100 hover:text-brass-300"
          >
            <Icon name="phone" class="size-4 text-brass-300" />
            {site.phone}
          </a>
        </li>
        <li>
          <a
            href="/contact"
            class="inline-flex items-center gap-2.5 text-ink-100 hover:text-brass-300"
          >
            <Icon name="mail" class="size-4 text-brass-300" />
            Send a request
          </a>
        </li>
        <li class="flex items-start gap-2.5 text-ink-300">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-brass-300" />
          <span>Mobile service across {site.city} &amp; area — no office visits required.</span>
        </li>
      </ul>

      <h2 class="mt-8 text-xs font-semibold uppercase tracking-[0.18em] text-brass-300">
        Hours
      </h2>
      <ul class="mt-4 space-y-1.5 text-sm text-ink-300">
        {
          site.hours.map((h) => (
            <li class="flex justify-between gap-4 border-b border-white/5 pb-1.5">
              <span>{h.days}</span>
              <span class="text-ink-100">{h.time}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-brass-300">
        Services
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          services.map((s) => (
            <li>
              <a
                href={`/services/${s.slug}/`}
                class="text-ink-200 hover:text-brass-300"
              >
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-brass-300">
        Pages
      </h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink-200 hover:text-brass-300">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="container-page flex flex-col gap-3 py-6 text-xs text-ink-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <p class="max-w-lg sm:text-right">
        This site is general information only and is not legal advice. A Commissioner
        for Oaths cannot certify true copies or advise you on your documents.
      </p>
    </div>
  </div>
</footer>
