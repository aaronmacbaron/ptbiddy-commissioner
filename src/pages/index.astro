---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import { site, pricing } from "../config/site";
import { steps, cannotDo, faqs, areas } from "../config/content";
import { services } from "../config/services";

const homeFaqs = faqs.slice(0, 6);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const highlights = [
  {
    icon: "car",
    title: "She comes to you",
    body: "Home, office, hospital room or a booth at Tim Hortons. There is no waiting room, because there is no office.",
  },
  {
    icon: "clock",
    title: "Evenings & weekends",
    body: "Appointments outside business hours are the norm here, not a favour. Same-day is usually available.",
  },
  {
    icon: "shield",
    title: "Flat, quoted upfront",
    body: `$${pricing.base} for the first document in Calgary. You hear the full price before she leaves — never after.`,
  },
];
---

<Layout
  title="Mobile Commissioner for Oaths"
  description={`Peggy is a mobile Commissioner for Oaths serving Calgary and area. Affidavits, statutory declarations and travel consent letters sworn at your home, office or hospital bedside — evenings and weekends included. Call ${site.phone}.`}
  schema={[faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-ink-100 bg-parchment">
    <div
      class="pointer-events-none absolute -right-40 top-[-10rem] size-[36rem] rounded-full bg-brass-200/35 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative grid gap-14 py-16 md:py-24 lg:grid-cols-[1.15fr_1fr] lg:items-center">
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-brass-300/60 bg-white/70 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-brass-700"
        >
          <span class="size-1.5 rounded-full bg-brass-500"></span>
          Serving {site.city} &amp; area
        </p>

        <h1 class="mt-6 text-[2.6rem] leading-[1.05] md:text-6xl">
          A Commissioner for Oaths who{" "}
          <span class="text-brass-600">drives to your door.</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
          Affidavits, statutory declarations, and child travel consent letters —
          properly sworn at your kitchen table, your office, or a hospital bedside.
          Peggy is appointed under Alberta's <em>Notaries and Commissioners Act</em>,
          and she works the hours you're actually free.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={`tel:${site.phoneHref}`}
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-ink-900 px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-ink-800"
          >
            <Icon name="phone" class="size-5 text-brass-300" />
            <span class="whitespace-nowrap">Call or text {site.phone}</span>
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center gap-2.5 rounded-full border border-ink-300 bg-white px-7 py-4 text-base font-semibold text-ink-800 transition-colors hover:border-ink-400"
          >
            Request an appointment
            <Icon name="chevron" class="size-4" />
          </a>
        </div>

        <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-ink-200/70 pt-8">
          <div>
            <dt class="text-xs uppercase tracking-[0.14em] text-ink-500">Typical visit</dt>
            <dd class="mt-1 font-display text-2xl text-ink-900">15 min</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em] text-ink-500">From</dt>
            <dd class="mt-1 font-display text-2xl text-ink-900">${pricing.base}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em] text-ink-500">Booking</dt>
            <dd class="mt-1 font-display text-2xl text-ink-900">Same day</dd>
          </div>
        </dl>
      </div>

      <!-- "What to bring" card doubles as a visual anchor -->
      <div class="relative">
        <div class="rounded-3xl border border-ink-200/70 bg-white p-8 shadow-xl shadow-ink-900/5 md:p-10">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brass-600">
            Bring three things
          </p>
          <h2 class="mt-3 font-display text-2xl text-ink-900">
            That's genuinely all it takes.
          </h2>
          <ul class="mt-7 space-y-5">
            {
              [
                {
                  t: "Government photo ID",
                  d: "Unexpired, and matching the name on the document.",
                },
                {
                  t: "Your document, filled in",
                  d: "Every blank completed except the signature and date.",
                },
                {
                  t: "An unsigned signature line",
                  d: "You must sign in front of Peggy — not before.",
                },
              ].map((item, i) => (
                <li class="flex gap-4">
                  <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brass-50 font-display text-sm font-semibold text-brass-700">
                    {i + 1}
                  </span>
                  <span>
                    <span class="block font-semibold text-ink-900">{item.t}</span>
                    <span class="mt-0.5 block text-sm leading-relaxed text-ink-500">
                      {item.d}
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="mt-8 rounded-xl bg-ink-50 p-4 text-sm leading-relaxed text-ink-600">
            Not sure your form needs a commissioner rather than a notary?{" "}
            <a href="/faq/" class="font-semibold text-brass-700 underline underline-offset-2"
              >Ask before you book</a
            > — it takes one phone call and saves a wasted appointment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights -->
  <section class="container-page -mt-px grid gap-6 py-16 md:grid-cols-3 md:py-20">
    {
      highlights.map((h) => (
        <div class="rounded-2xl border border-ink-100 bg-white p-7">
          <span class="grid size-11 place-items-center rounded-xl bg-ink-900 text-brass-300">
            <Icon name={h.icon} class="size-5" />
          </span>
          <h2 class="mt-5 text-xl">{h.title}</h2>
          <p class="mt-2.5 leading-relaxed text-ink-600">{h.body}</p>
        </div>
      ))
    }
  </section>

  <!-- Services -->
  <section class="border-y border-ink-100 bg-parchment/60 py-20">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
            What Peggy commissions
          </p>
          <h2 class="mt-3 text-3xl md:text-4xl">
            If your form says “sworn before me,” you're in the right place.
          </h2>
        </div>
        <a
          href="/services/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-ink-800 underline underline-offset-4 hover:text-brass-700"
        >
          See all services
          <Icon name="chevron" class="size-4" />
        </a>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <a
              href={`/services/${s.slug}/`}
              class="group flex flex-col rounded-2xl border border-ink-100 bg-white p-7 transition-shadow hover:shadow-lg hover:shadow-ink-900/5"
            >
              <span class="text-brass-600">
                <Icon name={s.icon} class="size-7" />
              </span>
              <h3 class="mt-4 text-xl group-hover:text-brass-700">{s.title}</h3>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-600">{s.blurb}</p>
              <ul class="mt-5 space-y-1.5 border-t border-ink-100 pt-5 text-sm text-ink-600">
                {s.examples.slice(0, 3).map((ex) => (
                  <li class="flex gap-2.5">
                    <Icon name="check" class="mt-1 size-3.5 shrink-0 text-brass-500" />
                    {ex}
                  </li>
                ))}
              </ul>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-ink-800 group-hover:text-brass-700">
                Learn more
                <Icon name="chevron" class="size-3.5" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-page py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
      How it works
    </p>
    <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">
      Four steps, and none of them involve parking downtown.
    </h2>

    <ol class="mt-12 grid gap-8 md:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="relative border-t-2 border-ink-200 pt-6">
            <span class="absolute -top-[0.9rem] left-0 grid size-7 place-items-center rounded-full bg-brass-500 font-display text-sm font-semibold text-white">
              {i + 1}
            </span>
            <h3 class="text-lg">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{step.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Scope honesty section -->
  <section class="border-y border-ink-100 bg-ink-50/60 py-20">
    <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
          Straight answers
        </p>
        <h2 class="mt-3 text-3xl md:text-4xl">What a Commissioner for Oaths can't do</h2>
        <p class="mt-5 leading-relaxed text-ink-600">
          Plenty of people book the wrong professional and lose an afternoon to it.
          Here's the honest boundary of the role in Alberta — if your document needs
          something on this list, Peggy will tell you before you book, not after.
        </p>
        <a
          href="/faq/"
          class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-ink-800 underline underline-offset-4 hover:text-brass-700"
        >
          Read the full FAQ
          <Icon name="chevron" class="size-4" />
        </a>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2">
        {
          cannotDo.map((item) => (
            <li class="rounded-2xl border border-ink-200/70 bg-white p-6">
              <span class="flex items-center gap-2.5 text-ink-400">
                <Icon name="x" class="size-4" />
                <span class="text-xs font-semibold uppercase tracking-[0.12em]">
                  Not a commissioner's role
                </span>
              </span>
              <h3 class="mt-3 text-base font-semibold text-ink-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Areas -->
  <section class="container-page py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
          Where she travels
        </p>
        <h2 class="mt-3 text-3xl md:text-4xl">All four quadrants, plus the ring of towns.</h2>
      </div>
      <a
        href="/service-area/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-ink-800 underline underline-offset-4 hover:text-brass-700"
      >
        Check your neighbourhood
        <Icon name="chevron" class="size-4" />
      </a>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        areas.map((a) => (
          <li class="flex items-start gap-3 rounded-xl border border-ink-100 bg-white p-5">
            <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-brass-500" />
            <span>
              <span class="block font-semibold text-ink-900">{a.name}</span>
              <span class="mt-0.5 block text-sm text-ink-500">{a.note}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- FAQ -->
  <section class="container-page pb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
      Common questions
    </p>
    <h2 class="mt-3 text-3xl md:text-4xl">Before you book</h2>
    <div class="mt-10">
      <FaqList items={homeFaqs} />
    </div>
    <a
      href="/faq/"
      class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-ink-800 underline underline-offset-4 hover:text-brass-700"
    >
      All {faqs.length} questions
      <Icon name="chevron" class="size-4" />
    </a>
  </section>

  <CtaBand />
</Layout>
