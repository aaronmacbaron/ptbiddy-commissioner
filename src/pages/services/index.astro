---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { heroDefault } from "../../config/heroImages";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { pricing, site } from "../../config/site";
import { cannotDo } from "../../config/content";
import { services } from "../../config/services";

const feeRows = [
  {
    label: "First document — within Calgary",
    price: `$${pricing.base}`,
    note: `Includes travel up to ${pricing.travelIncludedKm} km from downtown.`,
  },
  {
    label: "Each additional document",
    price: `$${pricing.perExtraDoc}`,
    note: "Signed at the same appointment.",
  },
  {
    label: "Evenings, weekends & holidays",
    price: `+$${pricing.afterHours}`,
    note: "Also applies to urgent same-day requests.",
  },
  {
    label: `Travel beyond ${pricing.travelIncludedKm} km`,
    price: `$${pricing.travelPerKm}/km`,
    note: "Quoted upfront before Peggy sets out.",
  },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Commissioner for Oaths services in Calgary",
  itemListElement: services.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: s.title,
    url: new URL(`/services/${s.slug}/`, site.url).href,
  })),
};
---

<Layout
  title="Services & Fees"
  description={`Affidavits, statutory declarations, oaths, child travel consent letters and signature witnessing — commissioned at your location anywhere in Calgary. Flat fees from $${pricing.base}.`}
  schema={[itemListSchema]}
>
  <PageHero
    image={heroDefault}
    eyebrow="Services & fees"
    title="Everything a Commissioner for Oaths can do — brought to wherever you are."
    lead="Peggy administers oaths and affirmations, takes affidavits, and takes statutory declarations under Alberta's Notaries and Commissioners Act. Pick the one that matches your document for the full detail, or call and describe the form."
  >
    <Breadcrumbs
      slot="breadcrumbs"
      trail={[{ label: "Home", href: "/" }, { label: "Services" }]}
    />
  </PageHero>

  <!-- Service directory -->
  <section class="container-page py-16 md:py-20">
    <div class="grid gap-8 md:grid-cols-2">
      {
        services.map((s) => (
          <article class="group relative flex flex-col rounded-2xl border border-ink-100 bg-white p-8 transition-shadow hover:shadow-lg hover:shadow-ink-900/5">
            <span class="grid size-12 place-items-center rounded-xl bg-brass-50 text-brass-700">
              <Icon name={s.icon} class="size-6" />
            </span>

            <h2 class="mt-5 text-2xl">
              <a href={`/services/${s.slug}/`} class="group-hover:text-brass-700">
                {/* Stretch the link across the whole card for easier tapping. */}
                <span class="absolute inset-0" />
                {s.title}
              </a>
            </h2>

            <p class="mt-3 leading-relaxed text-ink-600">{s.blurb}</p>

            <h3 class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">
              Commonly includes
            </h3>
            <ul class="mt-3 flex-1 space-y-2 text-sm text-ink-700">
              {s.examples.slice(0, 4).map((ex) => (
                <li class="flex gap-2.5">
                  <Icon name="check" class="mt-1 size-3.5 shrink-0 text-brass-500" />
                  {ex}
                </li>
              ))}
              {s.examples.length > 4 && (
                <li class="pl-6 text-ink-400">
                  + {s.examples.length - 4} more
                </li>
              )}
            </ul>

            <span class="mt-6 inline-flex items-center gap-2 border-t border-ink-100 pt-5 text-sm font-semibold text-ink-800 group-hover:text-brass-700">
              {s.title} in detail
              <Icon name="chevron" class="size-3.5" />
            </span>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Fees -->
  <section id="fees" class="scroll-mt-24 border-y border-ink-100 bg-parchment/60 py-20">
    <div class="container-page grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
          Fees
        </p>
        <h2 class="mt-3 text-3xl md:text-4xl">No surprises at the door.</h2>
        <p class="mt-5 leading-relaxed text-ink-600">
          You get the full amount — travel included — before Peggy leaves for your
          address. E-transfer, credit, debit and cash all work, and a receipt is
          issued every time.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-ink-500">
          Alberta does not set a fixed tariff for Commissioners for Oaths, so fees
          vary between providers. These are Peggy's, published so you can compare.
        </p>
      </div>

      <div class="overflow-hidden rounded-2xl border border-ink-200/70 bg-white">
        <table class="w-full text-left">
          <caption class="sr-only">Fee schedule</caption>
          <thead>
            <tr class="border-b border-ink-100 bg-ink-50/70">
              <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em] text-ink-500"
                >Service</th
              >
              <th scope="col" class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-[0.12em] text-ink-500"
                >Fee</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {
              feeRows.map((row) => (
                <tr>
                  <td class="px-6 py-5">
                    <span class="block font-semibold text-ink-900">{row.label}</span>
                    <span class="mt-1 block text-sm text-ink-500">{row.note}</span>
                  </td>
                  <td class="whitespace-nowrap px-6 py-5 text-right font-display text-xl text-ink-900">
                    {row.price}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Boundaries -->
  <section class="container-page py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
      Scope of the role
    </p>
    <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">
      Four things to send elsewhere — and Peggy will say so on the phone.
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        cannotDo.map((item) => (
          <div class="rounded-2xl border border-ink-200/70 bg-white p-7">
            <span class="flex items-center gap-2.5 text-ink-400">
              <Icon name="x" class="size-4" />
              <span class="text-xs font-semibold uppercase tracking-[0.12em]">
                Outside the role
              </span>
            </span>
            <h3 class="mt-3 text-lg">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-ink-600">{item.detail}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 max-w-3xl rounded-2xl bg-ink-50 p-6 leading-relaxed text-ink-600">
      Not certain which one you need? Call {site.phone} and read the line at the
      bottom of your form out loud. That's usually enough to settle it in under a
      minute.
    </p>
  </section>

  <CtaBand
    heading="Know what you need? Let's get it booked."
    body="Tell Peggy the document and your postal code, and she'll come back with the first available window — often today."
  />
</Layout>
