---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { heroDefault } from "../config/heroImages";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import Icon from "../components/Icon.astro";
import { site } from "../config/site";
import { faqs } from "../config/content";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const comparison = [
  { task: "Take an affidavit", coo: true, notary: true },
  { task: "Take a statutory declaration", coo: true, notary: true },
  { task: "Administer an oath or affirmation", coo: true, notary: true },
  { task: "Witness your signature on a form", coo: true, notary: true },
  { task: "Certify a true copy of a document", coo: false, notary: true },
  { task: "Notarize for use in another country", coo: false, notary: true },
  { task: "Give legal advice", coo: false, notary: false },
];
---

<Layout
  title="Frequently Asked Questions"
  description="What a Commissioner for Oaths does in Alberta, how it differs from a Notary Public, what ID you need, what it costs, and why you must not sign your document in advance."
  schema={[faqSchema]}
>
  <PageHero
    image={heroDefault}
    eyebrow="FAQ"
    title="The questions Peggy gets asked on the phone every week."
    lead="If yours isn't here, call and ask. It's a two-minute conversation that regularly saves people a wasted trip to the wrong professional."
  >
    <Breadcrumbs
      slot="breadcrumbs"
      trail={[{ label: "Home", href: "/" }, { label: "FAQ" }]}
    />
  </PageHero>

  <section class="container-page py-16 md:py-20">
    <FaqList items={faqs} />
  </section>

  <!-- Comparison table -->
  <section class="border-y border-ink-100 bg-parchment/60 py-20">
    <div class="container-page">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brass-600">
        Side by side
      </p>
      <h2 class="mt-3 max-w-2xl text-3xl md:text-4xl">
        Commissioner for Oaths vs. Notary Public in Alberta
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink-600">
        Every Notary Public in Alberta is also a Commissioner for Oaths, but not the
        other way around. This is the practical difference.
      </p>

      <div class="mt-10 overflow-x-auto rounded-2xl border border-ink-200/70 bg-white">
        <table class="w-full min-w-[34rem] text-left">
          <thead>
            <tr class="border-b border-ink-100 bg-ink-50/70">
              <th scope="col" class="px-6 py-4 text-xs font-semibold uppercase tracking-[0.12em] text-ink-500"
                >Task</th
              >
              <th scope="col" class="px-6 py-4 text-center text-xs font-semibold uppercase tracking-[0.12em] text-ink-500"
                >Commissioner for Oaths</th
              >
              <th scope="col" class="px-6 py-4 text-center text-xs font-semibold uppercase tracking-[0.12em] text-ink-500"
                >Notary Public</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-100">
            {
              comparison.map((row) => (
                <tr>
                  <td class="px-6 py-4 font-medium text-ink-800">{row.task}</td>
                  <td class="px-6 py-4">
                    <span class="mx-auto flex w-fit items-center gap-2">
                      <Icon
                        name={row.coo ? "check" : "x"}
                        class={row.coo ? "size-4 text-brass-600" : "size-4 text-ink-300"}
                      />
                      <span class="sr-only">{row.coo ? "Yes" : "No"}</span>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="mx-auto flex w-fit items-center gap-2">
                      <Icon
                        name={row.notary ? "check" : "x"}
                        class={row.notary ? "size-4 text-brass-600" : "size-4 text-ink-300"}
                      />
                      <span class="sr-only">{row.notary ? "Yes" : "No"}</span>
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-ink-500">
        General guidance only, and not legal advice. If your document has unusual
        requirements, confirm with the office or lawyer who gave it to you before
        booking anyone — including Peggy.
      </p>
    </div>
  </section>

  <CtaBand
    heading="Still not sure? Ask before you book."
    body={`Read the line at the bottom of your form to Peggy over the phone at ${site.phone}. She'll tell you honestly whether she's the right person for it.`}
  />
</Layout>
